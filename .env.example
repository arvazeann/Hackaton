DATABASE_URL=
AUTH_SECRET=
# Optional Google OAuth Web client credentials. Authorized redirect URIs:
# http://localhost:3000/api/auth/callback/google
# For a deployed/tunnel domain, use its HTTPS /api/auth/callback/google URI.
# Google does not allow raw non-loopback IPs as Web OAuth redirect hosts.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional: exact hostname/IP used to open the dev server from another device (no scheme/port).
NEXT_ALLOWED_DEV_ORIGIN=
UPLOAD_DIR=./storage/uploads
# Supabase Storage for uploaded product/profile images (server-only; never prefix the secret with NEXT_PUBLIC_).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=ruanglagi-images
# Generate a 32-byte AES key: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
PAYMENT_ENCRYPTION_KEY=
# Set only while manually running `npm run admin:bootstrap`; remove after use.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
